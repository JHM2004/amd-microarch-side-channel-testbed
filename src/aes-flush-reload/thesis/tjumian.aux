\@writefile{lof}{\defcounter {refsection}{0}\relax }\@writefile{lof}{\contentsline {figure}{\numberline {2-8}{\ignorespaces AES-128密钥扩展流程示意图。初始密钥的4个字$w_0$--$w_3$通过RotWord、SubWord和Rcon变换递归生成后续字。当$i \nonscript \mskip -\medmuskip \mkern 5mu\mathbin {\mathgroup \symoperators mod}\penalty 900 \mkern 5mu\nonscript \mskip -\medmuskip 4 = 0$时，$w_i = w_{i-4} \oplus SubWord(RotWord(w_{i-1})) \oplus Rcon[i/4]$；否则$w_i = w_{i-4} \oplus w_{i-1}$\relax }}{24}{figure.caption.11}\protected@file@percent }
\newlabel{fig:key_expansion}{{2-8}{24}{AES-128密钥扩展流程示意图。初始密钥的4个字$w_0$--$w_3$通过RotWord、SubWord和Rcon变换递归生成后续字。当$i \bmod 4 = 0$时，$w_i = w_{i-4} \oplus SubWord(RotWord(w_{i-1})) \oplus Rcon[i/4]$；否则$w_i = w_{i-4} \oplus w_{i-1}$\relax }{figure.caption.11}{}}
